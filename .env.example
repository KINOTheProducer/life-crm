# Used by docker compose. Generate secrets with: openssl rand -base64 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
PORT=3000

# AI extraction. Default is Claude: set ANTHROPIC_API_KEY.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# For a local model or another provider instead:
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=http://ollama:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=

# Speech to text (any OpenAI-compatible /audio/transcriptions endpoint).
# Defaults to the bundled whisper container.
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1

# Reminder emails. smtp://user:pass@host:587, or "log" to print them.
SMTP_URL=
EMAIL_FROM=Life CRM <reminders@example.com>
# Browser push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
