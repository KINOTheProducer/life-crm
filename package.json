{
  "name": "life-crm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @life-crm/db generate",
    "db:migrate": "pnpm --filter @life-crm/db migrate"
  },
  "devDependencies": {
    "turbo": "2.11.9",
    "typescript": "^5.9.3"
  }
}
